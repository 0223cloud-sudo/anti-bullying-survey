rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 老師帳號名單（要和 config.js 的 TEACHER_EMAILS 一致）
    function isTeacher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['0223cloud@gmail.com'];
    }

    // 學生匿名登入，每台裝置只能交一份，只有老師能看結果
    match /surveys/{sid} {
      allow read: if signedIn();
      allow write: if isTeacher();

      match /responses/{uid} {
        allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
        // 只能新增、不能修改（交過就不能再交）
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['g', 'items', 'round'])
          && request.resource.data.g in ['m', 'f', 'n']
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 17
          && request.resource.data.round is int;
        allow delete: if isTeacher();
      }
    }
  }
}
